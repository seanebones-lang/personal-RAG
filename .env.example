# PersonalRAGVault configuration (copy to .env and adjust)

# ChromaDB storage path
PRV_DB_PATH=~/.personalragvault/chroma

# Embedding: preset (mini | bge-small | bge-base) or explicit model id
PRV_EMBED_PRESET=mini
# PRV_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Ingest limits
PRV_MAX_FILE_BYTES=52428800
PRV_CHUNK_STRATEGY=char
# PRV_CHUNK_STRATEGY_BY_EXT=.md:recursive,.py:recursive
PRV_CHUNK_SIZE=800
PRV_CHUNK_OVERLAP=120
PRV_CHUNK_MIN_SIZE=200
PRV_CHUNK_MAX_SIZE=800
# PRV_SEMANTIC_THRESHOLD=0.5
PRV_MAX_CONTEXT_CHARS=12000

# Query defaults
PRV_MAX_TOP_K=50
PRV_EMBED_BATCH_SIZE=32
PRV_USE_FILE_CACHE=true
PRV_USE_FTS=true
PRV_USE_EMBEDDING_CACHE=true
PRV_HYBRID_FETCH_LIMIT=5000
PRV_HYBRID_RRF_K=60
PRV_HNSW_SEARCH_EF=100
PRV_HNSW_M=16

# Retrieval (off by default; or use a preset)
# PRV_QUERY_PRESET=balanced   # fast | balanced | quality
# PRV_MULTI_QUERY=false
# PRV_EXPAND_QUERY_OLLAMA=false
# PRV_RERANK=false
# PRV_RERANK_CANDIDATES=20
# PRV_PARENT_EXPAND=false

# Query response cache (non-stream)
PRV_RESPONSE_CACHE=true
PRV_RESPONSE_CACHE_TTL=3600
PRV_RESPONSE_CACHE_MAX=1000

# Large ingest: chunks per embed+upsert batch (streaming path)
PRV_INGEST_BATCH_SIZE=500

# Query default: hybrid BM25+vector when CLI/API omit explicit hybrid flag
# PRV_HYBRID=false

# Extra ingest directory names to skip (comma-separated; merged with built-ins)
# PRV_INGEST_EXCLUDE_DIRS=Private,tmp

# HTTP API (personalragvault serve)
# When set (non-empty), require Authorization: Bearer <token> on all routes
# except GET /health and GET /version. Leave unset for local-first (no auth).
# PRV_API_TOKEN=
# Allow POST /ingest with allow_outside_home (default denied for safety)
# PRV_API_ALLOW_OUTSIDE_HOME=0
